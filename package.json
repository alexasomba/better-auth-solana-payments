{
  "name": "better-auth-solana-payments",
  "version": "0.1.2",
  "description": "One-time Solana payment integration for Better Auth",
  "keywords": [
    "better-auth",
    "payments",
    "solana",
    "solana-pay"
  ],
  "homepage": "https://github.com/alexasomba/better-auth-solana-payments#readme",
  "bugs": {
    "url": "https://github.com/alexasomba/better-auth-solana-payments/issues"
  },
  "license": "MIT",
  "author": "alexasomba",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexasomba/better-auth-solana-payments.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./client": {
      "types": "./dist/client.d.mts",
      "import": "./dist/client.mjs",
      "default": "./dist/client.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test run",
    "lint": "vp lint src test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "vp check",
    "lint:package": "publint run --strict",
    "lint:types": "attw --profile esm-only --pack ."
  },
  "dependencies": {
    "better-call": "1.3.7",
    "defu": "^6.1.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@better-fetch/fetch": "^1.3.1",
    "@types/node": "^24.13.3",
    "publint": "^0.3.24",
    "typescript": "^6.0.3",
    "vite-plus": "0.2.6",
    "vitest": "4.1.10"
  },
  "peerDependencies": {
    "@better-fetch/fetch": "^1.3.1",
    "better-auth": "^1.6.25",
    "solana-payments": "^0.4.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@11.8.0"
}
