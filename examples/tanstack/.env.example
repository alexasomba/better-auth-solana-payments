BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000
VITE_BETTER_AUTH_URL=http://localhost:3000

# Use an SPL token mint that exists on devnet. The default USDT preset is mainnet.
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_MINT=replace-with-your-devnet-spl-token-mint
SOLANA_DECIMALS=6
SOLANA_SYMBOL=DEV-TOKEN
SOLANA_RECIPIENT=replace-with-your-devnet-recipient
